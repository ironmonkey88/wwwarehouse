#!/usr/bin/env python3
"""
WWWarehouse: Seal Protocol (CP-003)
Formalizes the Triple-Seal Gate (Alpha, Beta, Gamma).
"""

import sys
import os
import argparse
import datetime

# --- CONFIGURATION ---
LAB_PATH = "artifacts/quality_lab.md"
MODE_LOCK = ".factory/current_mode"

def check_identity():
    if not os.path.exists(MODE_LOCK):
        print("🔴 ERROR: Identity Lock Missing. Run verify_worker.py first.")
        return None
    with open(MODE_LOCK, 'r') as f:
        return f.read().strip()

def append_to_lab(bead_id, mode, status, summary):
    date_str = datetime.date.today().isoformat()
    entry = f"""
---
## 🛡️ Certification: {bead_id}
**Certified Date**: {date_str}  
**Audit Protocol**: Triple-Seal (Alpha, Beta, Gamma)  
**Lead Persona**: {mode}
**Status**: [{status}] ✅

### **Verification Summary (Seal Artifacts)**
{summary}

---
"""
    with open(LAB_PATH, 'a') as f:
        f.write(entry)

def main():
    parser = argparse.ArgumentParser(description="Witness Seal Protocol")
    parser.add_argument("bead_id", help="The ID of the Bead being certified")
    parser.add_argument("--alpha", action="store_true", help="Confirm Structural Integrity")
    parser.add_argument("--beta", action="store_true", help="Confirm Mathematical Integrity")
    parser.add_argument("--gamma", action="store_true", help="Confirm Governance Integrity")
    parser.add_argument("--memo", default="No additional memo provided.", help="Audit summary or proof")

    args = parser.parse_args()
    
    mode = check_identity()
    if not mode:
        sys.exit(1)

    if mode != "witness":
        print(f"⚠️  WARNING: You are in '{mode}' mode. Only the 'Witness' can officially Seal a bead.")
        # We allow it for now but log the persona drift
    
    if not (args.alpha and args.beta and args.gamma):
        print("❌ SEAL FAILED: Triple-Seal requires Alpha, Beta, AND Gamma confirmation.")
        sys.exit(1)

    print(f"🕯️  Sealing Bead: {args.bead_id}...")
    
    summary_table = f"| Seal | Verification | Result |\n| :--- | :--- | :--- |\n"
    summary_table += f"| **Alpha** | Structural Integrity | ✅ PASS |\n"
    summary_table += f"| **Beta** | Mathematical Integrity | ✅ PASS |\n"
    summary_table += f"| **Gamma** | Governance Integrity | ✅ PASS |\n\n"
    summary_table += f"**Memo**: {args.memo}"

    append_to_lab(args.bead_id, mode, "VERIFIED", summary_table)
    
    # Write a local physical token of the seal
    os.makedirs(".factory/sealed_beads", exist_ok=True)
    with open(f".factory/sealed_beads/{args.bead_id}", "w") as f:
        f.write(f"SEALED:{datetime.datetime.now().isoformat()}:{mode}")

    print(f"✅ BEAD {args.bead_id} SEALED. Certification appended to {LAB_PATH}.")

if __name__ == "__main__":
    main()
