#!/bin/bash

# [WITNESS] Pulse Command ⚡
# Provides a high-speed functional audit of the Sovereign Portal.

# Resolve the root directory of the project
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Execute the parallel verification script
# We explicitly propagate the exit code to ensure the gate works in CI/CD chains.
python3 "$PROJECT_ROOT/scripts/verify_portal.py" "$@"
EXIT_CODE=$?

if [ $EXIT_CODE -eq 0 ]; then
    echo "🟢 PULSE: STRONG."
else
    echo "🔴 PULSE: WEAK."
fi

exit $EXIT_CODE
